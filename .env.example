# ── Plantilla de variables de entorno ──────────────────────────
# Copia este archivo como ".env" y reemplaza los valores por los reales.
# NUNCA subas el .env con secretos al repositorio (ya está en .gitignore).

# Clave para firmar/validar los JWT (debe ser LA MISMA en auth_service y
# tienda_service). Usa una cadena aleatoria larga (mínimo 32 caracteres).
JWT_SECRET_KEY=cambia_esta_clave_por_una_aleatoria_de_32_chars

# Clave de sesión de Flask (puede ser la misma que JWT_SECRET_KEY o distinta).
SECRET_KEY=cambia_esta_clave_por_otra_aleatoria_de_32_chars

# URIs de las dos bases Supabase/PostgreSQL
DATABASE_URI_AUTH=postgresql://usuario:password@host:5432/auth_db
DATABASE_URI_TIENDA=postgresql://usuario:password@host:5432/tienda_db

# URLs base de cada microservicio (usadas para redirecciones entre servicios)
AUTH_SERVICE_URL=http://127.0.0.1:5001
TIENDA_SERVICE_URL=http://127.0.0.1:5002
